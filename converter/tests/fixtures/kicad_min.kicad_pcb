(kicad_pcb
  (version 20221022)
  (generator pcbnew)
  (general (thickness 1.6))
  (paper "A4")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user))
  (setup (stackup))
  (net 0 "")

  (gr_line (start 100 100) (end 145 100) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 145 100) (end 145 132) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 145 132) (end 108 132) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 108 132) (end 100 124) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 100 124) (end 100 100) (layer "Edge.Cuts") (width 0.1))

  (footprint "Resistor_SMD:R_0603_1608Metric"
    (layer "F.Cu")
    (at 112 106)
    (attr smd)
    (property "Reference" "R1" (at 0 -1.2 0) (layer "F.SilkS"))
    (property "Value" "10k" (at 0 1.2 0) (layer "F.Fab"))
    (pad "1" smd rect (at -0.75 0) (size 0.8 0.8) (layers "F.Cu"))
    (pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu"))
  )
  (footprint "Resistor_SMD:R_0603_1608Metric"
    (layer "F.Cu")
    (at 120 106)
    (attr smd)
    (property "Reference" "R2" (at 0 -1.2 0) (layer "F.SilkS"))
    (property "Value" "10KΩ" (at 0 1.2 0) (layer "F.Fab"))
    (pad "1" smd rect (at -0.75 0) (size 0.8 0.8) (layers "F.Cu"))
    (pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu"))
  )
  (footprint "Capacitor_SMD:C_0603_1608Metric"
    (layer "F.Cu")
    (at 128 106)
    (attr smd)
    (property "Reference" "C1" (at 0 -1.2 0) (layer "F.SilkS"))
    (property "Value" "104" (at 0 1.2 0) (layer "F.Fab"))
    (pad "1" smd rect (at -0.75 0) (size 0.8 0.8) (layers "F.Cu"))
    (pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "F.Cu"))
  )
  (footprint "LED_SMD:LED_0805_2012Metric"
    (layer "F.Cu")
    (at 118 114 90)
    (attr smd)
    (property "Reference" "LED1" (at 0 -1.4 0) (layer "F.SilkS"))
    (property "Value" "RED" (at 0 1.4 0) (layer "F.Fab"))
    (pad "1" smd rect (at -1 0) (size 1 0.6) (layers "F.Cu"))
    (pad "2" smd rect (at 1 0) (size 1 0.6) (layers "F.Cu"))
  )
  (footprint "Package_SO:TSSOP-8_3x3mm_P0.65mm"
    (layer "F.Cu")
    (at 132 118)
    (attr smd)
    (property "Reference" "U1" (at 0 -2.2 0) (layer "F.SilkS"))
    (property "Value" "ME6211" (at 0 2.2 0) (layer "F.Fab"))
    (pad "1" smd rect (at -1 -0.5) (size 0.6 0.4) (layers "F.Cu"))
    (pad "8" smd rect (at 1 0.5) (size 0.6 0.4) (layers "F.Cu"))
  )
  (footprint "Connector:USB_C_Receptacle"
    (layer "F.Cu")
    (at 104 112)
    (attr smd)
    (property "Reference" "J1" (at 0 -4.5 0) (layer "F.SilkS"))
    (property "Value" "USB-C" (at 0 4.5 0) (layer "F.Fab"))
    (pad "A1" smd rect (at -3 0) (size 1.2 2) (layers "F.Cu"))
    (pad "B1" smd rect (at 3 0) (size 1.2 2) (layers "F.Cu"))
  )
  (footprint "Resistor_SMD:R_0603_1608Metric"
    (layer "B.Cu")
    (at 118 124)
    (attr smd)
    (property "Reference" "R3" (at 0 -1.2 0) (layer "B.SilkS"))
    (property "Value" "4k7" (at 0 1.2 0) (layer "B.Fab"))
    (pad "1" smd rect (at -0.75 0) (size 0.8 0.8) (layers "B.Cu"))
    (pad "2" smd rect (at 0.75 0) (size 0.8 0.8) (layers "B.Cu"))
  )
  (footprint "MountingHole:MountingHole_3.2mm_M3"
    (layer "F.Cu")
    (at 140 126)
    (attr board_only exclude_from_pos_files exclude_from_bom)
    (property "Reference" "H1" (at 0 4 0) (layer "F.SilkS"))
    (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
  )
)
